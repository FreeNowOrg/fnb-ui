# Only generated or untracked output belongs here. Never add source: an
# always-red `pnpm format:check` teaches everyone to ignore it, but so does a
# gate that has been quietly narrowed until it checks nothing.

# Regenerated by pnpm on every install — formatting it just flips back.
pnpm-lock.yaml

# Build output (packages/*/dist, website/.vitepress/dist).
dist/

# VitePress dep-optimizer cache.
**/.vitepress/cache/

# Untracked local SDD scratch (.superpowers/sdd/.gitignore is `*`).
# Prettier 3 does not read .gitignore on its own.
.superpowers/

